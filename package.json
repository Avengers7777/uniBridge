  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node backend/server.js",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "vite frontend",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
