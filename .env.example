# GEMINI_API_KEY: Required for Gemini AI API calls (Optional, fallback heuristics enabled if missing)
GEMINI_API_KEY="your_gemini_api_key_here"

# Server Port (Default is 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL Connection String
# Option A: Neon Cloud PostgreSQL (SSL required)
DATABASE_URL="postgresql://neondb_owner:<password>@<neon-host>.neon.tech/neondb?sslmode=require"

# Option B: Local PostgreSQL instance
# DATABASE_URL="postgresql://postgres:password@localhost:5432/unibridge"

DB_NAME="unibridge"
